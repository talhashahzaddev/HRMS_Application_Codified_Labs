            COUNT(*) FILTER (WHERE LOWER(ftr.final_status) = 'on_leave')        AS leave_days_total,
            COUNT(*) FILTER (WHERE ftr.leave_pay_type = 'paid')                 AS paid_leave_days,
            COUNT(*) FILTER (WHERE ftr.leave_pay_type = 'unpaid')               AS unpaid_leave_days,
            COUNT(*) FILTER (WHERE ftr.leave_pay_type = 'half_paid')            AS half_paid_leave_days,
