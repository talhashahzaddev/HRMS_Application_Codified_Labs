            COALESCE(ob.late_minutes, 0),
            ROUND(COALESCE(ob.late_minutes, 0) / 60.0, 2),
            CASE
                WHEN COALESCE(ob.totalhours, 0) = 0 AND ob.status = 'absent' THEN 'absent'
