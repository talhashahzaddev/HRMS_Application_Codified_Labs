-- Name: fn_calculate_completion_rate(uuid); Type: FUNCTION; Schema: onboarding; Owner: postgres
--

CREATE FUNCTION onboarding.fn_calculate_completion_rate(p_onboarding_id uuid) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_session           onboarding.sessions%ROWTYPE;
    v_edu_count         integer;
    v_exp_count         integer;
    v_completed         integer := 0;
    v_total             integer := 7;
BEGIN
    -- Load session
    SELECT * INTO v_session
    FROM onboarding.sessions
    WHERE onboarding_id = p_onboarding_id
      AND is_deleted = false;
 
    IF NOT FOUND THEN
        RETURN 0;
    END IF;
 
    -- Count active education entries
    SELECT COUNT(*) INTO v_edu_count
    FROM onboarding.education
    WHERE onboarding_id = p_onboarding_id
      AND is_deleted = false;
 
    -- Count active work experience entries
    SELECT COUNT(*) INTO v_exp_count
    FROM onboarding.work_experience
    WHERE onboarding_id = p_onboarding_id
      AND is_deleted = false;
 
    -- Item 1: Personal details (text fields)
    IF  v_session.full_name    IS NOT NULL AND v_session.full_name    <> ''
    AND v_session.email        IS NOT NULL AND v_session.email        <> ''
    AND v_session.phone        IS NOT NULL AND v_session.phone        <> ''
    AND v_session.department   IS NOT NULL AND v_session.department   <> ''
    AND v_session.gender       IS NOT NULL AND v_session.gender       <> ''
    AND v_session.nationality  IS NOT NULL AND v_session.nationality  <> ''
    AND v_session.id_number    IS NOT NULL AND v_session.id_number    <> ''
    THEN
        v_completed := v_completed + 1;
    END IF;
 
    -- Item 2: Photo uploaded
    IF v_session.photo_url IS NOT NULL AND v_session.photo_url <> '' THEN
        v_completed := v_completed + 1;
    END IF;
 
    -- Item 3: Resume uploaded
    IF v_session.resume_url IS NOT NULL AND v_session.resume_url <> '' THEN
        v_completed := v_completed + 1;
    END IF;
 
    -- Item 4: Education
    IF v_edu_count > 0 THEN
        v_completed := v_completed + 1;
    END IF;
 
    -- Item 5: Work experience
    IF v_exp_count > 0 THEN
        v_completed := v_completed + 1;
    END IF;
 
    -- Item 6: Documents (any of education, experience, or resume)
    IF v_edu_count > 0
    OR v_exp_count > 0
    OR (v_session.resume_url IS NOT NULL AND v_session.resume_url <> '')
    THEN
        v_completed := v_completed + 1;
    END IF;
 
    -- Item 7: Policy accepted
    IF v_session.is_policy_accepted = true THEN
        v_completed := v_completed + 1;
    END IF;
 
    RETURN ROUND((v_completed::numeric / v_total::numeric) * 100);
END;
$$;


ALTER FUNCTION onboarding.fn_calculate_completion_rate(p_onboarding_id uuid) OWNER TO postgres;

--
-- TOC entry 493 (class 1255 OID 35994)
-- Name: fn_complete_onboarding(uuid); Type: FUNCTION; Schema: onboarding; Owner: postgres
--

CREATE FUNCTION onboarding.fn_complete_onboarding(p_onboarding_id uuid) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_session onboarding.sessions%ROWTYPE;
BEGIN
    SELECT * INTO v_session
    FROM onboarding.sessions
    WHERE onboarding_id = p_onboarding_id
      AND is_deleted = false;
 
    IF NOT FOUND THEN
        RETURN false;
    END IF;
 
    -- Must have accepted policies
    IF v_session.is_policy_accepted = false THEN
        RAISE EXCEPTION 'Cannot complete onboarding: policies not yet accepted.';
    END IF;
 
    -- Mark session completed
    UPDATE onboarding.sessions
    SET status       = 'completed',
        current_step = 6,
        updated_at   = NOW()
    WHERE onboarding_id = p_onboarding_id;
 
    -- Sync profile photo back to employee record (optional — only if photo was provided)
    IF v_session.photo_url IS NOT NULL AND v_session.photo_url <> '' THEN
        UPDATE employee.employees
        SET profilepictureurl = v_session.photo_url,
            updatedat         = NOW()
        WHERE employeeid = v_session.employee_id;
    END IF;
 
    RETURN true;
END;
$$;


