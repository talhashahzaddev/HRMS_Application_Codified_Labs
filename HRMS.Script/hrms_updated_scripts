--

CREATE FUNCTION attendance.fn_batch_finalize_timesheet(p_timesheet_id uuid, p_actioned_by uuid, p_employee_id uuid DEFAULT NULL::uuid) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_start_date  DATE;
    v_end_date    DATE;
    v_cutoff_date DATE;
    v_org_id      UUID;
    v_fin_count   INT := 0;
BEGIN
    SELECT period_start, period_end, organization_id
      INTO v_start_date, v_end_date, v_org_id
    FROM attendance.monthly_timesheets WHERE timesheet_id = p_timesheet_id;

    IF v_start_date IS NULL THEN
        RAISE EXCEPTION 'Timesheet snapshot % not found.', p_timesheet_id;
    END IF;

    v_cutoff_date := LEAST(v_end_date, CURRENT_DATE - 1);

    -- Step 1: Upsert finalized records for days with attendance rows
    WITH target_employees AS (
        SELECT e.employeeid FROM employee.employees e
        WHERE e.organizationid = v_org_id AND e.status != 'deleted'
          AND (p_employee_id IS NULL OR e.employeeid = p_employee_id)
    ),
    attendance_in_range AS (
        SELECT a.employeeid, a.attendanceid, a.workdate,
               a.checkintime, a.checkouttime, a.totalhours, a.status,
               a.late_minutes, a.overtimehours, a.overtimetype, a.leave_type_id
        FROM attendance.attendance a
        JOIN target_employees te ON te.employeeid = a.employeeid
        WHERE a.workdate >= v_start_date AND a.workdate <= v_end_date
    ),
    day_flags AS (
        SELECT air.*,
               EXTRACT(DOW FROM air.workdate) IN (0, 6) AS is_weekend,
               FALSE AS is_holiday
        FROM attendance_in_range air
    ),
    leave_info AS (
        SELECT df.*, lt.payout_type AS leave_pay_type
        FROM day_flags df
        LEFT JOIN attendance.leavetypes lt ON lt.leavetypeid::text = df.leave_type_id::text
    ),
    ot_breakdown AS (
        SELECT li.*,
               CASE WHEN li.overtimetype = 'regular' THEN COALESCE(li.overtimehours, 0) ELSE 0 END AS regular_ot,
               CASE WHEN li.overtimetype = 'weekend' THEN COALESCE(li.overtimehours, 0) ELSE 0 END AS weekend_ot,
               CASE WHEN li.overtimetype = 'holiday' THEN COALESCE(li.overtimehours, 0) ELSE 0 END AS holiday_ot,
               0 AS early_dep_minutes
        FROM leave_info li
    ),
    upserted AS (
        INSERT INTO attendance.finalized_timesheet_records
            (record_id, timesheet_id, employee_id, organization_id,
             attendance_id, work_date,
             final_checkin, final_checkout, final_total_hours,
             final_regular_hours, final_overtime_hours,
             final_late_minutes, final_late_hours,
             final_status, leave_type, leave_pay_type,
             is_weekend, is_holiday,
             final_regular_overtime_hours, final_weekend_overtime_hours,
             final_holiday_overtime_hours, final_early_departure_minutes,
             approved_by, approved_at, record_status)
        SELECT
            gen_random_uuid(), p_timesheet_id, ob.employeeid, v_org_id,
            ob.attendanceid, ob.workdate,
            ob.checkintime, ob.checkouttime,
