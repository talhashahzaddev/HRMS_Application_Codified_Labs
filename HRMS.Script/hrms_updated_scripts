    -- Step 2: Finalize absent days (no attendance row, not weekend)
    WITH target_employees AS (
        SELECT e.employeeid FROM employee.employees e
        WHERE e.organizationid = v_org_id AND e.status != 'deleted'
          AND (p_employee_id IS NULL OR e.employeeid = p_employee_id)
    ),
    absent_upserted AS (
        INSERT INTO attendance.finalized_timesheet_records
            (record_id, timesheet_id, employee_id, organization_id,
             attendance_id, work_date, final_status,
             is_weekend, is_holiday,
             approved_by, approved_at, record_status)
        SELECT gen_random_uuid(), p_timesheet_id, te.employeeid, v_org_id,
               NULL, gs.work_day::date, 'absent',
               EXTRACT(DOW FROM gs.work_day) IN (0, 6), FALSE,
               p_actioned_by, NOW(), 'finalized'
        FROM target_employees te
        CROSS JOIN generate_series(v_start_date, v_cutoff_date, '1 day'::interval) AS gs(work_day)
        WHERE EXTRACT(DOW FROM gs.work_day) NOT IN (0, 6)
          AND NOT EXISTS (
              SELECT 1 FROM attendance.attendance a
              WHERE a.employeeid = te.employeeid AND a.workdate = gs.work_day::date
