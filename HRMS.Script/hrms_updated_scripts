CREATE FUNCTION attendance.fn_aggregate_timesheet_payroll_summary(p_timesheet_id uuid, p_employee_id uuid DEFAULT NULL::uuid) RETURNS TABLE(total integer)
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_org_id UUID; v_start DATE; v_end DATE; v_total INTEGER := 0;
BEGIN
    SELECT organization_id, period_start, period_end
      INTO v_org_id, v_start, v_end
    FROM attendance.monthly_timesheets WHERE timesheet_id = p_timesheet_id;
    IF v_org_id IS NULL THEN RAISE EXCEPTION 'Timesheet % not found', p_timesheet_id; END IF;

    WITH ftr AS (
        SELECT * FROM attendance.finalized_timesheet_records
        WHERE timesheet_id = p_timesheet_id AND (p_employee_id IS NULL OR employee_id = p_employee_id)
    ),
    per_employee AS (
        SELECT
            ftr.employee_id,
            (v_end - v_start + 1) AS total_calendar_days,
            COUNT(*) FILTER (WHERE ftr.is_weekend) AS weekend_days,
            COUNT(*) FILTER (WHERE ftr.is_holiday) AS holiday_days,
            COUNT(*) FILTER (WHERE NOT ftr.is_weekend AND NOT ftr.is_holiday) AS scheduled_working_days,
            COUNT(*) FILTER (WHERE LOWER(ftr.final_status) IN ('present','late','half_day')) AS present_days,
            COUNT(*) FILTER (WHERE LOWER(ftr.final_status) = 'absent') AS absent_days,
            COUNT(*) FILTER (WHERE COALESCE(ftr.final_late_minutes, 0) > 0) AS late_days,
            COUNT(*) FILTER (WHERE LOWER(ftr.final_status) = 'half_day') AS half_days,
            COUNT(*) FILTER (WHERE LOWER(ftr.final_status) = 'early_departure') AS early_departure_days,
            COUNT(*) FILTER (WHERE LOWER(ftr.final_status) = 'on_leave') AS leave_days_total,
            COUNT(*) FILTER (WHERE ftr.leave_pay_type = 'paid') AS paid_leave_days,
            COUNT(*) FILTER (WHERE ftr.leave_pay_type = 'unpaid') AS unpaid_leave_days,
            COUNT(*) FILTER (WHERE ftr.leave_pay_type = 'half_paid') AS half_paid_leave_days,
            COALESCE(SUM(ftr.final_total_hours), 0) AS total_hours_worked,
            COALESCE(SUM(ftr.final_regular_hours), 0) AS regular_hours,
            COALESCE(SUM(ftr.final_overtime_hours), 0) AS overtime_hours,
            COALESCE(SUM(ftr.final_regular_overtime_hours), 0) AS regular_overtime_hours,
            COALESCE(SUM(ftr.final_weekend_overtime_hours), 0) AS weekend_overtime_hours,
            COALESCE(SUM(ftr.final_holiday_overtime_hours), 0) AS holiday_overtime_hours,
            COALESCE(SUM(ftr.final_late_minutes), 0) AS late_minutes,
            COALESCE(SUM(ftr.final_late_hours), 0) AS late_hours,
            COALESCE(SUM(ftr.final_early_departure_minutes), 0) AS early_departure_minutes
        FROM ftr GROUP BY ftr.employee_id
    ),
    upserted AS (
        INSERT INTO attendance.timesheet_payroll_summary AS tps
            (summary_id, timesheet_id, organization_id, employee_id,
             period_start, period_end,
             total_calendar_days, scheduled_working_days, weekend_days, holiday_days,
             present_days, absent_days, late_days, half_days, early_departure_days,
             leave_days_total, paid_leave_days, unpaid_leave_days, half_paid_leave_days,
             total_hours_worked, regular_hours, overtime_hours,
             regular_overtime_hours, weekend_overtime_hours, holiday_overtime_hours,
             late_minutes, late_hours, early_departure_minutes,
             effective_present_days, attendance_percentage,
             aggregated_at, created_at, updated_at)
        SELECT
            gen_random_uuid(), p_timesheet_id, v_org_id, pe.employee_id,
            v_start, v_end,
            pe.total_calendar_days, pe.scheduled_working_days, pe.weekend_days, pe.holiday_days,
            pe.present_days, pe.absent_days, pe.late_days, pe.half_days, pe.early_departure_days,
            pe.leave_days_total, pe.paid_leave_days, pe.unpaid_leave_days, pe.half_paid_leave_days,
            pe.total_hours_worked, pe.regular_hours, pe.overtime_hours,
            pe.regular_overtime_hours, pe.weekend_overtime_hours, pe.holiday_overtime_hours,
            pe.late_minutes, pe.late_hours, pe.early_departure_minutes,
            (pe.present_days + pe.paid_leave_days + (0.5 * pe.half_days))::numeric(6,2),
            CASE WHEN pe.scheduled_working_days > 0
                 THEN ROUND((pe.present_days + pe.paid_leave_days + (0.5 * pe.half_days))::numeric
                             / pe.scheduled_working_days * 100, 2) ELSE 0 END,
            NOW(), NOW(), NOW()
        FROM per_employee pe
        ON CONFLICT (timesheet_id, employee_id) DO UPDATE SET
            total_calendar_days = EXCLUDED.total_calendar_days, scheduled_working_days = EXCLUDED.scheduled_working_days,
            weekend_days = EXCLUDED.weekend_days, holiday_days = EXCLUDED.holiday_days,
            present_days = EXCLUDED.present_days, absent_days = EXCLUDED.absent_days,
            late_days = EXCLUDED.late_days, half_days = EXCLUDED.half_days,
            early_departure_days = EXCLUDED.early_departure_days,
            leave_days_total = EXCLUDED.leave_days_total, paid_leave_days = EXCLUDED.paid_leave_days,
            unpaid_leave_days = EXCLUDED.unpaid_leave_days, half_paid_leave_days = EXCLUDED.half_paid_leave_days,
            total_hours_worked = EXCLUDED.total_hours_worked, regular_hours = EXCLUDED.regular_hours,
            overtime_hours = EXCLUDED.overtime_hours,
            regular_overtime_hours = EXCLUDED.regular_overtime_hours,
            weekend_overtime_hours = EXCLUDED.weekend_overtime_hours,
            holiday_overtime_hours = EXCLUDED.holiday_overtime_hours,
            late_minutes = EXCLUDED.late_minutes, late_hours = EXCLUDED.late_hours,
            early_departure_minutes = EXCLUDED.early_departure_minutes,
            effective_present_days = EXCLUDED.effective_present_days,
            attendance_percentage = EXCLUDED.attendance_percentage,
            aggregated_at = NOW(), updated_at = NOW()
        RETURNING 1
    )
    SELECT COUNT(*) INTO v_total FROM upserted;
    RETURN QUERY SELECT v_total;
END;
$$;


