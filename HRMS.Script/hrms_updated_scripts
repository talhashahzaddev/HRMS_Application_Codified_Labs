-- TOC entry 453 (class 1255 OID 37538)
-- Name: fn_finalize_attendance_record(uuid, uuid, boolean, text); Type: FUNCTION; Schema: attendance; Owner: postgres
--

CREATE FUNCTION attendance.fn_finalize_attendance_record(p_request_id uuid, p_actioned_by uuid, p_is_approved boolean, p_rejection_reason text DEFAULT NULL::text) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_req RECORD;
    v_totalhours NUMERIC(5,2);
BEGIN
    SELECT * INTO v_req
    FROM attendance.attendance_update_requests
    WHERE request_id = p_request_id AND status = 'pending';

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Request not found or already processed.';
    END IF;

    IF v_req.timesheet_id IS NOT NULL THEN
        IF EXISTS (
            SELECT 1 FROM attendance.monthly_timesheets
            WHERE timesheet_id = v_req.timesheet_id AND status IN ('Locked','Archived')
        ) THEN
            RAISE EXCEPTION 'TIMESHEET_LOCKED: Cannot process correction on a locked or archived timesheet.'
                USING ERRCODE = 'P0001';
        END IF;
    END IF;

    IF p_is_approved THEN
        IF v_req.requested_checkin IS NOT NULL AND v_req.requested_checkout IS NOT NULL THEN
            v_totalhours := ROUND(
                EXTRACT(EPOCH FROM (v_req.requested_checkout - v_req.requested_checkin)) / 3600, 2
            );
            IF v_totalhours < 0 THEN v_totalhours := 0; END IF;
        ELSE
            SELECT COALESCE(tc.full_day_threshold_hours, 8)
            INTO v_totalhours
            FROM employee.employees e
            JOIN attendance.timesheet_config tc ON tc.organization_id = e.organizationid
            WHERE e.employeeid = v_req.employee_id LIMIT 1;
            IF v_totalhours IS NULL THEN v_totalhours := 8; END IF;
        END IF;

        INSERT INTO attendance.attendance
            (employeeid, workdate, status, checkintime, checkouttime,
             totalhours, overtimehours, overtimetype, late_minutes, leave_type_id)
        VALUES
            (v_req.employee_id, v_req.workdate, v_req.requested_status,
             CASE WHEN v_req.requested_status = 'absent' THEN NULL ELSE v_req.requested_checkin END,
             CASE WHEN v_req.requested_status = 'absent' THEN NULL ELSE v_req.requested_checkout END,
             CASE WHEN v_req.requested_status = 'absent' THEN 0 ELSE v_totalhours END,
             CASE WHEN v_req.requested_status = 'absent' THEN 0 ELSE COALESCE(v_req.requested_overtime_hours, 0) END,
             CASE WHEN v_req.requested_status = 'absent' THEN NULL ELSE v_req.requested_overtime_type END,
             CASE WHEN v_req.requested_status = 'absent' THEN 0
                  ELSE attendance.fn_calculate_late_minutes(v_req.employee_id, v_req.workdate, v_req.requested_checkin)
             END,
             v_req.requested_leave_type_id)
        ON CONFLICT (employeeid, workdate) DO UPDATE SET
            status        = EXCLUDED.status,
            checkintime   = EXCLUDED.checkintime,
            checkouttime  = EXCLUDED.checkouttime,
            totalhours    = EXCLUDED.totalhours,
            overtimehours = EXCLUDED.overtimehours,
            overtimetype  = EXCLUDED.overtimetype,
            late_minutes  = EXCLUDED.late_minutes,
            leave_type_id = EXCLUDED.leave_type_id,
            updatedat     = CURRENT_TIMESTAMP;

        UPDATE attendance.attendance_update_requests
        SET status = 'approved', actioned_by = p_actioned_by, actioned_at = CURRENT_TIMESTAMP
        WHERE request_id = p_request_id;
    ELSE
        UPDATE attendance.attendance_update_requests
        SET status = 'rejected', actioned_by = p_actioned_by, actioned_at = CURRENT_TIMESTAMP,
            rejection_reason = p_rejection_reason
        WHERE request_id = p_request_id;
    END IF;

    RETURN TRUE;
END;
$$;


