CREATE FUNCTION attendance.fn_clock_in_out(p_employee_id uuid, p_action character varying, p_timestamp timestamp with time zone DEFAULT CURRENT_TIMESTAMP, p_location jsonb DEFAULT NULL::jsonb, p_notes character varying DEFAULT NULL::character varying) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    todayDate DATE := (p_timestamp AT TIME ZONE 'UTC')::DATE;
    attendanceRecord RECORD;
    v_ip TEXT;
    v_break_minutes INT := 0;
    v_break_start TIME;
    v_break_end TIME;
BEGIN
    v_ip := p_location ->> 'ip';

    SELECT * INTO attendanceRecord
    FROM attendance.Attendance
    WHERE employeeId = p_employee_id AND workDate = todayDate;

    IF attendanceRecord IS NULL THEN
        INSERT INTO attendance.Attendance (employeeId, workDate, location, status, attendance_state, notes)
        VALUES (p_employee_id, todayDate, COALESCE(p_location, '{}'), 'present', 'checked_in', p_notes)
        RETURNING * INTO attendanceRecord;
    END IF;

    IF p_action = 'in' THEN
        UPDATE attendance.Attendance
        SET checkInTime = p_timestamp, checkOutTime = NULL,
            status = 'present', attendance_state = 'checked_in',
            location = COALESCE(p_location, location), updatedAt = CURRENT_TIMESTAMP
        WHERE attendanceId = attendanceRecord.attendanceId;

        INSERT INTO attendance.AttendanceSessions (attendanceId, checkInTime, location, checkinip)
        VALUES (attendanceRecord.attendanceId, p_timestamp, COALESCE(p_location, '{}'), v_ip);

    ELSIF p_action = 'out' THEN
        UPDATE attendance.Attendance
        SET checkOutTime = p_timestamp, attendance_state = 'checked_out',
            location = COALESCE(p_location, location), notes = COALESCE(p_notes, notes),
            updatedAt = CURRENT_TIMESTAMP
        WHERE attendanceId = attendanceRecord.attendanceId;

        UPDATE attendance.AttendanceSessions
        SET checkOutTime = p_timestamp, location = COALESCE(p_location, location),
            checkoutip = v_ip, updatedAt = CURRENT_TIMESTAMP
        WHERE sessionId = (
            SELECT sessionId FROM attendance.AttendanceSessions
            WHERE attendanceId = attendanceRecord.attendanceId AND checkOutTime IS NULL
            ORDER BY checkInTime DESC LIMIT 1
        );

        SELECT COALESCE(s.breakduration, 0), s.breakstarttime, s.breakendtime
        INTO v_break_minutes, v_break_start, v_break_end
        FROM employee.employmentdetails ed
        JOIN attendance.shifts s ON ed.shiftid = s.shiftid
        WHERE ed.employeeid = p_employee_id AND ed.iscurrent = true;

        UPDATE attendance.Attendance
        SET totalHours = GREATEST(0, (
            SELECT COALESCE(SUM(EXTRACT(EPOCH FROM (checkOutTime - checkInTime))) / 3600, 0)
            FROM attendance.AttendanceSessions
            WHERE attendanceId = attendanceRecord.attendanceId AND checkOutTime IS NOT NULL
        ) - (v_break_minutes / 60.0)),
        breakhours = v_break_minutes / 60.0,
        breakstarttime = CASE WHEN v_break_start IS NOT NULL THEN (todayDate + v_break_start) AT TIME ZONE 'UTC' ELSE NULL END,
        breakendtime = CASE WHEN v_break_end IS NOT NULL THEN (todayDate + v_break_end) AT TIME ZONE 'UTC' ELSE NULL END,
