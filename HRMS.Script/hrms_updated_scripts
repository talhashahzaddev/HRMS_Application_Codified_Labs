CREATE FUNCTION employee.fn_get_employees(p_organization_id uuid DEFAULT NULL::uuid, p_search_term character varying DEFAULT NULL::character varying, p_department_id uuid DEFAULT NULL::uuid, p_position_id uuid DEFAULT NULL::uuid, p_employment_type character varying DEFAULT NULL::character varying, p_status character varying DEFAULT NULL::character varying, p_limit integer DEFAULT 50, p_offset integer DEFAULT 0) RETURNS TABLE(employeeid uuid, employeecode character varying, firstname character varying, lastname character varying, email character varying, phone character varying, hiredate date, status character varying, departmentid uuid, departmentname character varying, profilepictureurl character varying, positionid uuid, positiontitle character varying, employmenttype character varying, paytype character varying, basicsalary numeric, reportingmanagerid uuid, reportingmanagername character varying, gender character varying, nationality character varying, maritalstatus character varying, dateofbirth date, address jsonb, emergencycontact jsonb, roleid uuid, rolename character varying, categoryid uuid, categoryname character varying, totalcount bigint)
    LANGUAGE plpgsql
    AS $$
DECLARE
    total_records BIGINT;
BEGIN

    SELECT COUNT(*) INTO total_records
    FROM employee.employees e
    LEFT JOIN employee.employmentdetails ed 
        ON e.employeeid = ed.employeeid AND ed.iscurrent = true
    LEFT JOIN employee.positions pos
        ON ed.positionid = pos.positionid
    WHERE (p_organization_id IS NULL OR e.organizationid = p_organization_id)
      AND (p_department_id IS NULL OR ed.departmentid = p_department_id)
      AND (p_position_id IS NULL OR ed.positionid = p_position_id)
      AND (p_employment_type IS NULL OR ed.employmenttype = p_employment_type)
      AND (p_search_term IS NULL OR 
           LOWER(CONCAT(e.firstname, ' ', e.lastname, ' ', e.email, ' ', e.employeecode)) 
           LIKE LOWER('%' || p_search_term || '%'))
      AND (p_status IS NULL OR e.status = p_status);

    RETURN QUERY
    SELECT 
        e.employeeid,
        e.employeecode,
        e.firstname,
        e.lastname,
        e.email,
        e.phone,
        e.hiredate,
        e.status,
        ed.departmentid,
        d.departmentname,
        e.profilepictureurl,
        ed.positionid,
        pos.positiontitle,
        ed.employmenttype,
        ed.paytype,
        ed.basicsalary,
        ed.reportingmanagerid,
        (CASE 
            WHEN rm.firstname IS NULL AND rm.lastname IS NULL THEN NULL
            ELSE rm.firstname || ' ' || rm.lastname
         END)::character varying,
        e.gender,
        e.nationality,
        e.maritalstatus,
        e.dateofbirth,
        e.address::jsonb,
        e.emergencycontact::jsonb,
        r.roleid,
        r.rolename,

        e.categoryid,          -- ✅ added
        tc.categoryname,       -- ✅ added

        total_records
    FROM employee.employees e
    LEFT JOIN employee.employmentdetails ed 
        ON e.employeeid = ed.employeeid AND ed.iscurrent = true
    LEFT JOIN employee.departments d 
        ON ed.departmentid = d.departmentid
    LEFT JOIN employee.positions pos 
        ON ed.positionid = pos.positionid
    LEFT JOIN auth.roles r
    	ON pos.roleid = r.roleid AND r.organizationid = e.organizationid
    LEFT JOIN employee.employees rm
        ON ed.reportingmanagerid = rm.employeeid
    LEFT JOIN payroll.taxcategories tc   -- ✅ added
        ON e.categoryid = tc.categoryid

    WHERE (p_organization_id IS NULL OR e.organizationid = p_organization_id)
      AND (p_department_id IS NULL OR ed.departmentid = p_department_id)
      AND (p_position_id IS NULL OR ed.positionid = p_position_id)
      AND (p_employment_type IS NULL OR ed.employmenttype = p_employment_type)
      AND (p_search_term IS NULL OR 
           LOWER(CONCAT(e.firstname, ' ', e.lastname, ' ', e.email, ' ', e.employeecode)) 
           LIKE LOWER('%' || p_search_term || '%'))
      AND (p_status IS NULL OR e.status = p_status)
    ORDER BY e.firstname, e.lastname
    LIMIT p_limit OFFSET p_offset;

END;
$$;


