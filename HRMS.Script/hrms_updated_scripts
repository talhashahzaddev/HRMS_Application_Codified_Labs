                         / ea.scheduled_working_days::numeric) * 100, 2)
             ELSE 0 END,
        NOW(), NOW()
    FROM employee_agg ea
    ON CONFLICT (timesheet_id, employee_id) DO UPDATE SET
        total_calendar_days = EXCLUDED.total_calendar_days, scheduled_working_days = EXCLUDED.scheduled_working_days,
        weekend_days = EXCLUDED.weekend_days, holiday_days = EXCLUDED.holiday_days,
        present_days = EXCLUDED.present_days, absent_days = EXCLUDED.absent_days,
        late_days = EXCLUDED.late_days, half_days = EXCLUDED.half_days,
        early_departure_days = EXCLUDED.early_departure_days,
        leave_days_total = EXCLUDED.leave_days_total, paid_leave_days = EXCLUDED.paid_leave_days,
        unpaid_leave_days = EXCLUDED.unpaid_leave_days, half_paid_leave_days = EXCLUDED.half_paid_leave_days,
        total_hours_worked = EXCLUDED.total_hours_worked, regular_hours = EXCLUDED.regular_hours,
        overtime_hours = EXCLUDED.overtime_hours,
        regular_overtime_hours = EXCLUDED.regular_overtime_hours,
        weekend_overtime_hours = EXCLUDED.weekend_overtime_hours,
        holiday_overtime_hours = EXCLUDED.holiday_overtime_hours,
        late_minutes = EXCLUDED.late_minutes, late_hours = EXCLUDED.late_hours,
        early_departure_minutes = EXCLUDED.early_departure_minutes,
        effective_present_days = EXCLUDED.effective_present_days,
        attendance_percentage = EXCLUDED.attendance_percentage,
        aggregated_at = NOW(), updated_at = NOW();

    -- Step 4: Flip status
    IF p_employee_id IS NULL THEN
        UPDATE attendance.monthly_timesheets
        SET status = 'Finalized', finalized_at = NOW(), finalized_by = p_actioned_by
        WHERE timesheet_id = p_timesheet_id;
    ELSE
        IF NOT EXISTS (
            SELECT 1 FROM employee.employees e
            WHERE e.organizationid = v_org_id AND e.status != 'deleted'
              AND NOT EXISTS (
                  SELECT 1 FROM attendance.finalized_timesheet_records ftr
                  WHERE ftr.employee_id = e.employeeid AND ftr.timesheet_id = p_timesheet_id
                    AND ftr.record_status IN ('finalized','overridden') AND ftr.work_date <= CURRENT_DATE
              )
              AND EXISTS (
                  SELECT 1 FROM generate_series(v_start_date, LEAST(v_end_date, CURRENT_DATE - 1), '1 day'::interval) AS gs(d)
                  WHERE EXTRACT(DOW FROM gs.d) NOT IN (0, 6)
              )
        ) THEN
            UPDATE attendance.monthly_timesheets
            SET status = 'Finalized', finalized_at = NOW(), finalized_by = p_actioned_by
            WHERE timesheet_id = p_timesheet_id;
        END IF;
    END IF;

    RETURN v_fin_count;
END;
$$;


