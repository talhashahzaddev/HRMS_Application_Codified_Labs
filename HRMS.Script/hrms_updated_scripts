CREATE FUNCTION attendance.fn_calculate_late_minutes(p_employee_id uuid, p_workdate date, p_checkin timestamp with time zone) RETURNS integer
    LANGUAGE plpgsql STABLE
    AS $$
DECLARE
    v_shift_start TIME;
    v_shift_grace INTEGER;
    v_org_id      UUID;
    v_grace       INTEGER;
    v_late_min    INTEGER;
    v_default_grace CONSTANT INTEGER := 15;
BEGIN
    IF p_checkin IS NULL THEN RETURN 0; END IF;

    SELECT s.starttime, NULLIF(COALESCE(s.grace_minutes, 0), 0), e.organizationid
      INTO v_shift_start, v_shift_grace, v_org_id
      FROM employee.employees e
      JOIN employee.employmentdetails ed ON ed.employeeid = e.employeeid AND ed.iscurrent = TRUE
      JOIN attendance.shifts s            ON s.shiftid     = ed.shiftid
     WHERE e.employeeid = p_employee_id
     LIMIT 1;

    IF v_shift_start IS NULL THEN RETURN 0; END IF;

    v_grace := v_shift_grace;

    IF v_grace IS NULL THEN
        SELECT graceminutes INTO v_grace
          FROM payroll.lateattendancerules
         WHERE organizationid = v_org_id
           AND COALESCE(isactive, TRUE)  = TRUE
           AND COALESCE(isdeleted, FALSE) = FALSE
         ORDER BY updatedat DESC NULLS LAST LIMIT 1;
    END IF;

    IF v_grace IS NULL THEN v_grace := v_default_grace; END IF;

    v_late_min := GREATEST(
        FLOOR(EXTRACT(EPOCH FROM (p_checkin::time - (v_shift_start + (v_grace || ' minutes')::INTERVAL))) / 60),
        0
    )::INTEGER;

    RETURN v_late_min;
END;
$$;


