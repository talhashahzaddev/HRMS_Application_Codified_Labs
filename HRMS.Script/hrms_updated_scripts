--
-- TOC entry 474 (class 1255 OID 37542)
-- Name: fn_timesheet_transition(uuid, character varying, uuid, text); Type: FUNCTION; Schema: attendance; Owner: postgres
--

CREATE FUNCTION attendance.fn_timesheet_transition(p_timesheet_id uuid, p_new_status character varying, p_actor_id uuid, p_reason text DEFAULT NULL::text) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_current VARCHAR;
    v_valid   BOOLEAN;
    v_snapshot JSONB;
BEGIN
    SELECT status INTO v_current FROM attendance.monthly_timesheets WHERE timesheet_id = p_timesheet_id;
    IF NOT FOUND THEN RAISE EXCEPTION 'Timesheet not found.' USING ERRCODE = 'P0001'; END IF;

    v_valid := CASE
        WHEN v_current = 'Draft'       AND p_new_status = 'InProgress'  THEN TRUE
        WHEN v_current = 'Draft'       AND p_new_status = 'Archived'    THEN TRUE
        WHEN v_current = 'InProgress'  AND p_new_status = 'Submitted'   THEN TRUE
        WHEN v_current = 'InProgress'  AND p_new_status = 'Archived'    THEN TRUE
        WHEN v_current = 'Submitted'   AND p_new_status = 'UnderReview' THEN TRUE
        WHEN v_current = 'Submitted'   AND p_new_status = 'InProgress'  THEN TRUE
        WHEN v_current = 'UnderReview' AND p_new_status = 'Approved'    THEN TRUE
        WHEN v_current = 'UnderReview' AND p_new_status = 'Submitted'   THEN TRUE
        WHEN v_current = 'Approved'    AND p_new_status = 'Finalized'   THEN TRUE
        WHEN v_current = 'Finalized'   AND p_new_status = 'Locked'      THEN TRUE
        WHEN v_current = 'Finalized'   AND p_new_status = 'Archived'    THEN TRUE
        WHEN v_current = 'Locked'      AND p_new_status = 'Archived'    THEN TRUE
        ELSE FALSE
    END;
    IF NOT v_valid THEN RAISE EXCEPTION 'Invalid transition from % to %', v_current, p_new_status USING ERRCODE = 'P0001'; END IF;

    UPDATE attendance.monthly_timesheets
    SET status           = p_new_status,
        submitted_at     = CASE WHEN p_new_status = 'Submitted'  THEN NOW() ELSE submitted_at END,
        finalized_at     = CASE WHEN p_new_status = 'Finalized'  THEN NOW() ELSE finalized_at END,
        locked_at        = CASE WHEN p_new_status = 'Locked'     THEN NOW() ELSE locked_at END,
        submitted_by     = CASE WHEN p_new_status = 'Submitted'  THEN p_actor_id ELSE submitted_by END,
        finalized_by     = CASE WHEN p_new_status = 'Finalized'  THEN p_actor_id ELSE finalized_by END,
        locked_by        = CASE WHEN p_new_status = 'Locked'     THEN p_actor_id ELSE locked_by END,
        rejection_reason = CASE WHEN v_current = 'UnderReview' AND p_new_status = 'Submitted' THEN p_reason ELSE rejection_reason END
    WHERE timesheet_id = p_timesheet_id;

    INSERT INTO attendance.timesheet_audit_log
        (timesheet_id, entity_type, entity_id, action, actor_id, actor_role, old_values, new_values, reason)
    VALUES
        (p_timesheet_id, 'period', p_timesheet_id, 'transition', p_actor_id, 'manager',
         jsonb_build_object('status', v_current), jsonb_build_object('status', p_new_status), p_reason);

    IF p_new_status IN ('Submitted', 'Approved') THEN
        SELECT jsonb_agg(jsonb_build_object(
            'employeeId', a.employeeid, 'workDate', a.workdate,
            'status', a.status, 'totalHours', a.totalhours,
            'overtimeHours', a.overtimehours, 'lateMinutes', a.late_minutes,
            'attendanceId', a.attendanceid
        )) INTO v_snapshot
        FROM attendance.attendance a
        JOIN attendance.monthly_timesheets mt ON a.workdate BETWEEN mt.period_start AND mt.period_end
        WHERE mt.timesheet_id = p_timesheet_id;

        IF v_snapshot IS NOT NULL THEN
            INSERT INTO attendance.timesheet_transition_snapshots (timesheet_id, status_at, snapshot_json)
            VALUES (p_timesheet_id, p_new_status, v_snapshot);
        END IF;
    END IF;

    RETURN TRUE;
END;
$$;


