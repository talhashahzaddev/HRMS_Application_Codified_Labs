                current_year,
                lt.maxdaysperyear,
                0,
                lt.maxdaysperyear,
                0,
                NOW()
            FROM attendance.leavetypes lt
            WHERE lt.leavetypeid = p_leavetype_id;
        END IF;
    END LOOP;
END;
$$;


