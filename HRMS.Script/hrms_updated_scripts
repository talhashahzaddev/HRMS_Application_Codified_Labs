            final_overtime_hours = EXCLUDED.final_overtime_hours, final_late_minutes = EXCLUDED.final_late_minutes,
            final_late_hours = EXCLUDED.final_late_hours, final_status = EXCLUDED.final_status,
            leave_type = EXCLUDED.leave_type, leave_pay_type = EXCLUDED.leave_pay_type,
            is_weekend = EXCLUDED.is_weekend, is_holiday = EXCLUDED.is_holiday,
            final_regular_overtime_hours = EXCLUDED.final_regular_overtime_hours,
            final_weekend_overtime_hours = EXCLUDED.final_weekend_overtime_hours,
            final_holiday_overtime_hours = EXCLUDED.final_holiday_overtime_hours,
            final_early_departure_minutes = EXCLUDED.final_early_departure_minutes,
            approved_by = EXCLUDED.approved_by, approved_at = EXCLUDED.approved_at,
            record_status = CASE WHEN attendance.finalized_timesheet_records.record_status = 'overridden'
