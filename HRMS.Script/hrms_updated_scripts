CREATE FUNCTION attendance.fn_validate_correction_employee_match() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE v_attendance_owner uuid;
BEGIN
    IF NEW.attendance_id IS NOT NULL THEN
        SELECT employeeid INTO v_attendance_owner
        FROM attendance.attendance WHERE attendanceid = NEW.attendance_id;
        IF v_attendance_owner IS DISTINCT FROM NEW.employee_id THEN
            RAISE EXCEPTION 'CORRECTION_EMPLOYEE_MISMATCH: The attendance record belongs to employee %, but the correction is for employee %.',
                v_attendance_owner, NEW.employee_id
            USING ERRCODE = 'P0003';
        END IF;
    END IF;
    RETURN NEW;
END;
$$;


