CREATE FUNCTION onboarding.update_field_configurations(p_organizationid uuid, p_json jsonb) RETURNS boolean
    LANGUAGE plpgsql
    AS $$
BEGIN

    INSERT INTO onboarding.field_configurations (
        organizationid,
        section,
        fieldkey,
        enabled,
        required,
        updatedat
    )
    SELECT
        p_organizationid,
        item->>'section',
        item->>'fieldKey',
        COALESCE((item->>'enabled')::BOOLEAN, true),
        COALESCE((item->>'required')::BOOLEAN, false),
        CURRENT_TIMESTAMP
    FROM jsonb_array_elements(p_json) AS item

    ON CONFLICT (organizationid, section, fieldkey)
    DO UPDATE SET
        enabled = EXCLUDED.enabled,
        required = EXCLUDED.required,
        updatedat = CURRENT_TIMESTAMP;

    RETURN TRUE;

END;
$$;


