CREATE FUNCTION attendance.fn_approve_all_pending_requests(p_manager_id uuid, p_org_id uuid, p_timesheet_id uuid, p_employee_id uuid DEFAULT NULL::uuid) RETURNS integer
    LANGUAGE plpgsql
    AS $$
DECLARE v_count integer := 0;
BEGIN
    WITH approved_requests AS (
        UPDATE attendance.attendance_update_requests
        SET status = 'approved', actioned_by = p_manager_id, actioned_at = CURRENT_TIMESTAMP,
            timesheet_id = p_timesheet_id
        WHERE organization_id = p_org_id AND status = 'pending'
          AND (p_employee_id IS NULL OR employee_id = p_employee_id)
          AND timesheet_id = p_timesheet_id
        RETURNING request_id, employee_id, organization_id, attendance_id, workdate,
                  requested_checkin, requested_checkout, requested_status,
                  requested_leave_type_id, requested_overtime_hours,
                  requested_overtime_type, requested_late_minutes
    ),
    updated_attendance AS (
        UPDATE attendance.attendance a
        SET checkintime   = CASE WHEN ar.requested_status = 'absent' THEN NULL ELSE ar.requested_checkin END,
            checkouttime  = CASE WHEN ar.requested_status = 'absent' THEN NULL ELSE ar.requested_checkout END,
            status        = ar.requested_status,
            totalhours    = CASE WHEN ar.requested_status = 'absent' THEN 0 ELSE a.totalhours END,
            overtimehours = CASE WHEN ar.requested_status = 'absent' THEN 0 ELSE COALESCE(ar.requested_overtime_hours, a.overtimehours) END,
            overtimetype  = CASE WHEN ar.requested_status = 'absent' THEN NULL ELSE COALESCE(ar.requested_overtime_type, a.overtimetype) END,
            late_minutes  = CASE WHEN ar.requested_status = 'absent' THEN 0 ELSE COALESCE(ar.requested_late_minutes, a.late_minutes) END,
            leave_type_id = CASE
                WHEN ar.requested_status = 'absent' THEN NULL
                WHEN ar.requested_leave_type_id IS NOT NULL THEN ar.requested_leave_type_id
                ELSE a.leave_type_id
            END,
            updatedat = CURRENT_TIMESTAMP
        FROM approved_requests ar
        WHERE a.attendanceid = ar.attendance_id AND ar.attendance_id IS NOT NULL
    )
    SELECT COUNT(*) INTO v_count FROM approved_requests;
    RETURN v_count;
END;
$$;


