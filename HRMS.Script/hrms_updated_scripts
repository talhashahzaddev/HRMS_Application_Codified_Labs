            (attendanceid, checkintime, location, checkinip,
             geofenceid, latitude, longitude, location_status, distance_from_fence_m, face_log_id)
        VALUES
            (v_att.attendanceid, p_timestamp, COALESCE(p_location, '{}'::jsonb), v_ip,
