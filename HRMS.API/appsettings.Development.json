{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=hrms_db;Username=postgres;"
  },
  "JwtSettings": {
    "SecretKey": "development-jwt-secret-key-for-local-testing-should-be-changed-for-production-environments-256-bits",
    "Issuer": "HRMS-API-Dev",
    "Audience": "HRMS-Client-Dev",
    "AccessTokenExpirationMinutes": 480,
    "RefreshTokenExpirationDays": 30
  },
  "CORS": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000",
      "http://127.0.0.1:4200"
    ]
  }
}
